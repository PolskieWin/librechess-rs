<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:paddingLeft="12dp"
    android:paddingRight="12dp">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LibreChess RS"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_user_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_flat"
            android:text="Polskie (100)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_flat"
            android:text="Settings"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Opponent Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/txt_opponent_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bot 100"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_opponent_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Chessboard -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center">

        <com.polskie.librechess.ChessBoardView
            android:id="@+id/chess_board"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Player Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/txt_player_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Polskie (100)"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_player_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:typeface="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status & Move Evaluation Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/txt_status_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="White to move"
            android:textColor="#38BDF8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_review_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#A855F7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Standard Gameplay Action Buttons -->
    <LinearLayout
        android:id="@+id/layout_game_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_new_game"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="New"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_bot"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="Bot"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_flip"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="Flip"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_hint"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="Hint"
            android:textColor="#06B6D4"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_resign"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="Resign"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_review"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="Review"
            android:textColor="#A855F7"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Review Navigation Bar (Visible only during post-game review) -->
    <LinearLayout
        android:id="@+id/layout_review_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_rev_start"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="|&lt;"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_rev_prev"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="&lt;"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_rev_next"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="&gt;"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_rev_end"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="&gt;|"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btn_rev_exit"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.4"
            android:layout_margin="2dp"
            android:background="@drawable/btn_flat"
            android:text="Exit"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

</LinearLayout>
